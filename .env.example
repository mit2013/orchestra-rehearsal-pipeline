# Box / Google Drive / LINE の資格情報。このファイルをコピーして .env を作る。
# .env は .gitignore で除外されている。絶対にコミットしないこと。

BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# 共有リンクのパスワードの接尾辞。パスワードは {concert_date}{この値} になる。
# リポジトリには置かないこと(共有 URL を知る人が誰でも計算できてしまう)。
BOX_PASSWORD_SUFFIX=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
